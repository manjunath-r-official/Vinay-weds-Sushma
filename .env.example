# Copy this file to .env and fill in values as needed.
# None of these are required for the site to run — they're optional
# integrations you can wire up in src/config/config.js.

# Endpoint for RSVP form submissions (e.g. Formspree, a custom API,
# a Google Apps Script Web App URL). Leave blank to just log to console.
VITE_RSVP_ENDPOINT=

# Endpoint for Memory Wall submissions. Leave blank to keep it local
# to each visitor's session.
VITE_MEMORY_WALL_ENDPOINT=
